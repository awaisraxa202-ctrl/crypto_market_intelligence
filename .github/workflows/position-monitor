name: Position Monitor (frequent, lightweight)

# This does NOT run on GitHub's own cron — scheduled Actions on low-traffic repos
# get delayed by hours (this is a GitHub platform limitation, not something a
# workflow file can fix). Instead this listens for workflow_dispatch, which an
# external free scheduler (cron-job.org) calls every 10-15 minutes via the
# GitHub API. See README.md "Free frequent monitoring" for setup.
#
# This job only checks existing open positions against the live price for
# stop-loss / take-profit — it does NOT run the full 9-asset indicator pipeline,
# so it's fast (seconds) and cheap (well inside GitHub's free Actions minutes).

on:
  workflow_dispatch:

# Both this and the other workflow write docs/paper_account.json and push to
# main. Without a shared concurrency group they can run simultaneously and one
# will clobber or fail to push over the other. Same group name in both files
# means GitHub queues them instead of racing.
concurrency:
  group: market-cortex-write
  cancel-in-progress: false

permissions:
  contents: write

jobs:
  check:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4
        with:
          ref: main

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.11'

      - name: Install minimal dependencies
        run: pip install pandas numpy requests

      - name: Check open positions only
        run: python crypto_market_intelligence_v60.py --check-positions-only

      - name: Commit if anything changed
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "github-actions[bot]@users.noreply.github.com"
          git add docs/paper_account.json docs/signal_database.json
          if git diff --staged --quiet; then
            echo "No changes — nothing to commit."
            exit 0
          fi
          git commit -m "Position check $(date -u +%H:%M)"
          # The main 2-hour pipeline also pushes to main; pull-rebase avoids a
          # rejected push if both happen to run close together.
          git pull --rebase origin main
          git push
